<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests for WinMuse.Core: models, the library database, matching, lyrics, audio decoding and the view models.
    Run:  dotnet test tests\WinMuse.Tests   (MUSIC_TEST_DIR = a folder of real songs for the decoder tests; optional)
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1416;MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinMuse.Core\WinMuse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\external\ffmpeg\avcodec-*.dll;..\..\external\ffmpeg\avformat-*.dll;..\..\external\ffmpeg\avutil-*.dll;..\..\external\ffmpeg\swresample-*.dll"
          Link="ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
