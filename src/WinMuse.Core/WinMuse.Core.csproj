<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Everything in the app that doesn't need a window: models, the library and its database, metadata, lyrics, playback
    and the audio engine, settings, and the view models the pages bind to. No WinUI reference, so the app and the tests
    share one copy of this code and the tests can build any of it with fakes.
    Services reach the UI thread and show notifications only through IUiDispatcher and INotifier, passed in by the app.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>WinMuse</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1416;MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="AcoustID.NET" Version="1.3.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinMuse.Tests" />
  </ItemGroup>
</Project>
