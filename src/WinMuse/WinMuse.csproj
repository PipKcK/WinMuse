<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>WinMuse</RootNamespace>
    <AssemblyName>WinMuse</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform.ToLower())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <NoWarn>$(NoWarn);CA1416;MVVMTK0045;CS8618;CS8602;CS8604</NoWarn>

    <!-- Internal identity is WinMuse; everything user-facing says "Music". -->
    <Product>Music</Product>
    <AssemblyTitle>Music</AssemblyTitle>
    <Description>Music</Description>
    <Company>WinMuse</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251106002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7175" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="AcoustID.NET" Version="1.3.3" />
  </ItemGroup>

  <PropertyGroup>
    <!-- FFmpeg for the CPU being built for (an ARM64 app can't load x64 DLLs): external\ffmpeg (x64) or external\ffmpeg-arm64. -->
    <FFmpegArch Condition="'$(Platform)' == 'ARM64'">arm64</FFmpegArch>
    <FFmpegArch Condition="'$(FFmpegArch)' == ''">x64</FFmpegArch>
    <FFmpegDir Condition="'$(FFmpegArch)' == 'arm64'">..\..\external\ffmpeg-arm64</FFmpegDir>
    <FFmpegDir Condition="'$(FFmpegDir)' == ''">..\..\external\ffmpeg</FFmpegDir>
    <!-- Only the libraries the player uses (decode, demux, resample); avfilter/avdevice/swscale are not shipped. -->
    <FFmpegFiles>$(FFmpegDir)\avcodec-*.dll;$(FFmpegDir)\avformat-*.dll;$(FFmpegDir)\avutil-*.dll;$(FFmpegDir)\swresample-*.dll;$(FFmpegDir)\LICENSE.txt</FFmpegFiles>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Downloader: put mdown.exe in src\WinMuse\Tools; it is copied next to WinMuse.exe (Tools\mdown.exe). -->
    <None Include="Tools\**\*" Exclude="Tools\README.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(FFmpegFiles)" Link="ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Custom app icon: set AppIconPng to a square PNG (256x256 or larger), e.g.
      dotnet build -p:AppIconPng=C:\path\to\logo.png
    or uncomment the property below. The build regenerates Assets\AppIcon.ico and Assets\AppIcon.png from it.
  -->
  <PropertyGroup>
    <!-- <AppIconPng>$(MSBuildThisFileDirectory)..\..\branding\icon.png</AppIconPng> -->
  </PropertyGroup>
  <Target Name="GenerateAppIcon" BeforeTargets="BeforeBuild" Condition="'$(AppIconPng)' != ''">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\Make-Icons.ps1&quot; -FromPng &quot;$(AppIconPng)&quot;" />
  </Target>

  <!-- Fetch FFmpeg automatically on first build if it is missing. -->
  <Target Name="EnsureFFmpeg" BeforeTargets="BeforeBuild" Condition="!Exists('$(MSBuildThisFileDirectory)$(FFmpegDir)\avcodec-62.dll')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\Get-FFmpeg.ps1&quot; -Arch $(FFmpegArch)" />
    <ItemGroup>
      <None Include="$(FFmpegFiles)" Link="ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
