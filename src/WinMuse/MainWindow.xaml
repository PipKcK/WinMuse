<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinMuse.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinMuse.Controls"
    xmlns:views="using:WinMuse.Views"
    Title="Music">

    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="OnAccelPlayPause" />
            <KeyboardAccelerator Key="Right" Modifiers="Control" Invoked="OnAccelNext" />
            <KeyboardAccelerator Key="Left" Modifiers="Control" Invoked="OnAccelPrevious" />
            <KeyboardAccelerator Key="Up" Modifiers="Control" Invoked="OnAccelVolumeUp" />
            <KeyboardAccelerator Key="Down" Modifiers="Control" Invoked="OnAccelVolumeDown" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnAccelSearch" />
            <KeyboardAccelerator Key="M" Modifiers="Control" Invoked="OnAccelMini" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnAccelShuffle" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnAccelRepeat" />
            <KeyboardAccelerator Key="F11" Invoked="OnAccelNowPlaying" />
            <KeyboardAccelerator Key="Escape" Invoked="OnAccelEscape" />
        </Grid.KeyboardAccelerators>

        <!-- ===== Background layers ===== -->
        <Grid x:Name="BackgroundHost" Grid.RowSpan="3" IsHitTestVisible="False">
            <controls:AmbientBackground x:Name="Ambient" Opacity="0">
                <controls:AmbientBackground.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.8" />
                </controls:AmbientBackground.OpacityTransition>
            </controls:AmbientBackground>
            <Image x:Name="WallpaperImage" Stretch="UniformToFill" Opacity="0">
                <Image.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.6" />
                </Image.OpacityTransition>
            </Image>
            <Rectangle x:Name="BackgroundScrim" Opacity="0">
                <Rectangle.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.6" />
                </Rectangle.OpacityTransition>
            </Rectangle>
        </Grid>

        <!-- ===== Title bar ===== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftInset" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightInset" Width="140" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="40" Height="36" CornerRadius="6" Margin="6,0,0,0"
                    Content="&#xE72B;" FontSize="13" Click="OnBack" IsEnabled="False" ToolTipService.ToolTip="Back" AutomationProperties.Name="Back" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="10,0,0,0" VerticalAlignment="Center">
                <!-- The logo, in the accent color (Settings > Appearance > App icon). -->
                <!-- Nudged down: centered on the "Music" text's letters rather than its line box. -->
                <controls:AppLogo x:Name="TitleLogo" Width="20" Height="20" Margin="0,2,0,0" />
                <TextBlock x:Name="AppNameText" Text="Music" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel x:Name="ScanIndicator" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" Margin="8,0,0,0">
                    <ProgressRing IsActive="True" Width="12" Height="12" />
                    <TextBlock x:Name="ScanText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="3" MaxWidth="460" Margin="16,0" VerticalAlignment="Center"
                            PlaceholderText="Search songs, albums, artists" QueryIcon="Find"
                            TextChanged="OnSearchTextChanged" QuerySubmitted="OnSearchSubmitted" SuggestionChosen="OnSuggestionChosen"
                            UpdateTextOnSelect="False">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="views:SearchSuggestion">
                        <Grid ColumnSpacing="10" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:ArtImage Width="32" Height="32" CornerRadius="4" DecodeSize="40" Source="{x:Bind ArtPath}" Seed="{x:Bind Title}" Glyph="{x:Bind Glyph}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
        </Grid>

        <!-- ===== Navigation + content ===== -->
        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        OpenPaneLength="232"
                        CompactModeThresholdWidth="760"
                        ExpandedModeThresholdWidth="1080"
                        ItemInvoked="OnNavItemInvoked">
            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">1,1,0,0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">8,0,0,0</CornerRadius>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Songs" Tag="songs">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEC4F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Albums" Tag="albums">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE93C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Artists" Tag="artists">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE716;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Genres" Tag="genres">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8EC;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Playlists" Tag="playlists">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE90B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Queue" Tag="queue">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="QueueBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Download" Tag="download">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Fetch" Tag="fetch" ToolTipService.ToolTip="Download song details, album art, artist photos and lyrics, and see where each came from">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEBD3;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Navigated="OnNavigated">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>

        <!-- ===== Spectrum behind the player bar: it stays within the bar, whose acrylic diffuses its colors ===== -->
        <controls:Visualizer x:Name="BarViz" Grid.Row="2" Height="92" VerticalAlignment="Bottom"
                             BarCount="56" BarOpacity="0.9" Gain="1.5" FadeTop="True" Visibility="Collapsed" />

        <!-- ===== Player bar ===== -->
        <controls:PlayerBar x:Name="PlayerBar" Grid.Row="2" />

        <!-- ===== Selection action bar (selection mode) ===== -->
        <Border x:Name="SelectionBar" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Visibility="Collapsed"
                CornerRadius="12" Padding="16,8" Background="{ThemeResource GlassBrush}" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="SelectionCount" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,10,0" MinWidth="90" />
                <Button Click="OnSelectionPlay">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontSize="13" /><TextBlock Text="Play" /></StackPanel>
                </Button>
                <Button Click="OnSelectionQueue">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8FD;" FontSize="13" /><TextBlock Text="Add to queue" /></StackPanel>
                </Button>
                <Button x:Name="SelectionPlaylistButton" Click="OnSelectionPlaylist">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE90B;" FontSize="13" /><TextBlock Text="Add to playlist" /></StackPanel>
                </Button>
                <Button Click="OnSelectionAll" Content="Select all" />
                <Button Click="OnSelectionCancel" Content="Cancel" ToolTipService.ToolTip="Clear selection (Esc)" />
            </StackPanel>
        </Border>

        <!-- ===== Queue panel (bottom right) ===== -->
        <controls:QueuePanel x:Name="QueueCard" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,16" Visibility="Collapsed" />

        <!-- ===== Now Playing overlay ===== -->
        <views:NowPlayingView x:Name="NowPlaying" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" />

        <!-- ===== Notifications ===== -->
        <StackPanel x:Name="Toasts" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Spacing="8" MaxWidth="420">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromHorizontalOffset="60" FromVerticalOffset="0" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
        </StackPanel>
    </Grid>
</Window>
