<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinMuse.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinMuse.Controls"
    xmlns:helpers="using:WinMuse.Helpers">

    <UserControl.Resources>
        <helpers:TimeTooltipConverter x:Key="TimeTip" />
        <helpers:PercentTooltipConverter x:Key="PercentTip" />
        <helpers:DbTooltipConverter x:Key="DbTip" />
    </UserControl.Resources>

    <Grid x:Name="Root" Height="92" Background="{ThemeResource PlayerBarBrush}" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,0">
        <!-- A thin accent glow along the top edge that follows the album color. -->
        <Rectangle Height="1" VerticalAlignment="Top" Fill="{StaticResource AccentGradientBrush}" Opacity="0.55" />

        <Grid Padding="16,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- Now playing info -->
            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ArtButton" Padding="0" BorderThickness="0" Background="Transparent" CornerRadius="8" Click="OnArtClick"
                        ToolTipService.ToolTip="Open Now Playing" AutomationProperties.Name="Open Now Playing" local:Effects.HoverScale="1.06">
                    <Grid>
                        <local:ArtImage x:Name="Art" Width="60" Height="60" CornerRadius="8" DecodeSize="72"
                                        Source="{x:Bind helpers:Conv.ArtOf(Player.CurrentTrack), Mode=OneWay}"
                                        Seed="{x:Bind helpers:Conv.SeedOf(Player.CurrentTrack), Mode=OneWay}" />
                        <Border x:Name="ArtHover" CornerRadius="8" Background="#66000000" Opacity="0">
                            <Border.OpacityTransition><ScalarTransition Duration="0:0:0.15" /></Border.OpacityTransition>
                            <FontIcon Glyph="&#xE70E;" Foreground="White" FontSize="16" />
                        </Border>
                    </Grid>
                </Button>
                <StackPanel x:Name="InfoPanel" Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <!-- Left-aligned with a star title column: the heart sits right after a short title, and a long title
                         is trimmed instead of pushing the heart out of view. -->
                    <Grid ColumnSpacing="4" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind helpers:Conv.TitleOf(Player.CurrentTrack), Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                        <Button x:Name="StarButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="26" Height="26" FontSize="13" Content="&#xEB51;"
                                Click="OnStar" Visibility="Collapsed" ToolTipService.ToolTip="Add to Favorite" AutomationProperties.Name="Favorite" />
                    </Grid>
                    <HyperlinkButton Padding="0" Click="OnArtistClick" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <HyperlinkButton.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Light">
                                        <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                        <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Dark">
                                        <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                        <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </HyperlinkButton.Resources>
                        <TextBlock Text="{x:Bind helpers:Conv.ArtistOf(Player.CurrentTrack), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </HyperlinkButton>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Visibility="{x:Bind helpers:Conv.HiRes(Player.CurrentTrack), Mode=OneWay}" Background="{StaticResource AccentGradientBrush}" CornerRadius="3" Padding="4,0">
                            <TextBlock Text="Hi-Res" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <TextBlock Text="{x:Bind helpers:Conv.FormatOf(Player.CurrentTrack), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Transport + seek -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Width="460">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                    <ToggleButton Style="{StaticResource IconToggleButtonStyle}" Content="&#xE8B1;" IsChecked="{x:Bind Player.Shuffle, Mode=TwoWay}" ToolTipService.ToolTip="Shuffle (Ctrl+S)" AutomationProperties.Name="Shuffle (Ctrl+S)" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE892;" Click="OnPrevious" ToolTipService.ToolTip="Previous (Ctrl+Left)" AutomationProperties.Name="Previous (Ctrl+Left)" />
                    <Button x:Name="PlayButton" Style="{StaticResource PlayButtonStyle}" Click="OnPlayPause" ToolTipService.ToolTip="{x:Bind helpers:Conv.PlayLabel(Player.IsPlaying), Mode=OneWay}">
                        <FontIcon x:Name="PlayGlyph" Glyph="{x:Bind helpers:Conv.PlayGlyph(Player.IsPlaying), Mode=OneWay}" FontSize="18" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE893;" Click="OnNext" ToolTipService.ToolTip="Next (Ctrl+Right)" AutomationProperties.Name="Next (Ctrl+Right)" />
                    <ToggleButton x:Name="RepeatButton" Style="{StaticResource IconToggleButtonStyle}" Click="OnRepeat"
                                  Content="{x:Bind helpers:Conv.RepeatGlyph(Player.Repeat), Mode=OneWay}"
                                  IsChecked="{x:Bind helpers:Conv.RepeatOn(Player.Repeat), Mode=OneWay}"
                                  ToolTipService.ToolTip="{x:Bind helpers:Conv.RepeatTip(Player.Repeat), Mode=OneWay}" />
                </StackPanel>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind helpers:Conv.Time(Player.Position), Mode=OneWay}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="{x:Bind helpers:Conv.Max1(Player.Duration), Mode=OneWay}" StepFrequency="0.1" IsThumbToolTipEnabled="True"
                            ThumbToolTipValueConverter="{StaticResource TimeTip}" VerticalAlignment="Center" Margin="0,-4" />
                    <TextBlock Grid.Column="2" Text="{x:Bind helpers:Conv.Time(Player.Duration), Mode=OneWay}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </StackPanel>

            <!-- Extras -->
            <StackPanel x:Name="Extras" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                <Button x:Name="LyricsButton" Style="{StaticResource IconButtonStyle}" Content="&#xE8BD;" Click="OnLyrics" ToolTipService.ToolTip="Lyrics" AutomationProperties.Name="Lyrics" />
                <ToggleButton x:Name="QueueButton" Style="{StaticResource IconToggleButtonStyle}" Content="&#xE8FD;" Click="OnQueue" ToolTipService.ToolTip="Queue panel" AutomationProperties.Name="Queue panel" />
                <Button x:Name="EqButton" Style="{StaticResource IconButtonStyle}" Content="&#xE9E9;" ToolTipService.ToolTip="Equalizer" AutomationProperties.Name="Equalizer">
                    <Button.Flyout>
                        <Flyout Placement="Top" Opening="OnEqOpening">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                    <Setter Property="MaxWidth" Value="640" />
                                    <Setter Property="Padding" Value="20,16" />
                                    <Setter Property="CornerRadius" Value="12" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel Width="440" Spacing="10">
                                <!-- Title; genre matching and where the current EQ comes from. -->
                                <Grid>
                                    <TextBlock Text="Equalizer" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                                    <StackPanel HorizontalAlignment="Right" Spacing="0">
                                        <ToggleSwitch x:Name="EqGenreToggle" HorizontalAlignment="Right" MinWidth="0" OnContent="Match genre" OffContent="Match genre"
                                                      Toggled="OnEqGenreToggled" ToolTipService.ToolTip="Use the preset that suits each song's genre. Songs with a saved equalizer keep theirs." />
                                        <TextBlock x:Name="EqSourceText" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,-6,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <!-- Preset and save for the current song. -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="EqPresets" HorizontalAlignment="Stretch" SelectionChanged="OnEqPresetChanged" AutomationProperties.Name="Preset" />
                                    <Button x:Name="EqSaveButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnEqSave" AutomationProperties.Name="Save for this song"
                                            ToolTipService.ToolTip="Save this equalizer for the song that is playing">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon x:Name="EqSaveIcon" Glyph="&#xE74E;" FontSize="13" />
                                            <TextBlock x:Name="EqSaveText" Text="Save" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid x:Name="EqBandsGrid" Height="180" ColumnSpacing="4" Margin="0,6,0,0" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Preamp" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Slider x:Name="PreampSlider" Grid.Column="1" Minimum="-12" Maximum="12" StepFrequency="0.5" ThumbToolTipValueConverter="{StaticResource DbTip}" ValueChanged="OnPreampChanged" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Content="{x:Bind helpers:Conv.VolumeGlyph(Player.Volume, Player.IsMuted), Mode=OneWay}" Click="OnMute" ToolTipService.ToolTip="Mute" AutomationProperties.Name="Mute" />
                <Slider x:Name="VolumeSlider" Width="92" Minimum="0" Maximum="1" StepFrequency="0.01" VerticalAlignment="Center"
                        Value="{x:Bind Player.Volume, Mode=TwoWay}" ThumbToolTipValueConverter="{StaticResource PercentTip}" />
                <Button x:Name="MiniButton" Style="{StaticResource IconButtonStyle}" Content="&#xEE49;" Click="OnMiniPlayer" ToolTipService.ToolTip="Mini player (Ctrl+M)" AutomationProperties.Name="Mini player (Ctrl+M)" Margin="6,0,0,0" />
                <Button x:Name="ExpandButton" Style="{StaticResource IconButtonStyle}" Content="&#xE740;" Click="OnArtClick" ToolTipService.ToolTip="Now Playing (F11)" AutomationProperties.Name="Now Playing (F11)" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
