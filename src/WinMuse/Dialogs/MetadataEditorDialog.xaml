<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinMuse.Dialogs.MetadataEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinMuse.Controls"
    Style="{StaticResource DefaultContentDialogStyle}"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
    </ContentDialog.Resources>

    <Grid Width="760" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="BodyRow" Height="480" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:ArtImage x:Name="HeaderArt" Width="72" Height="72" CornerRadius="10" DecodeSize="96" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="HeaderTitle" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HeaderSub" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <SelectorBar x:Name="Tabs" Grid.Row="1" SelectionChanged="OnTabChanged">
            <SelectorBarItem x:Name="TabDetails" Text="Details" Tag="details" IsSelected="True" />
            <SelectorBarItem x:Name="TabArt" Text="Artwork" Tag="art" />
            <SelectorBarItem x:Name="TabLyrics" Text="Lyrics" Tag="lyrics" />
            <SelectorBarItem x:Name="TabFile" Text="File" Tag="file" />
        </SelectorBar>

        <!-- Details: grouped into cards (Song, Album, Comment). Pickers and text boxes share label spacing so rows line up. -->
        <ScrollViewer x:Name="DetailsPanel" Grid.Row="2" Padding="0,0,14,0">
            <StackPanel Spacing="12" Padding="0,2,0,4">
                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEC4F;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Song" Style="{StaticResource EditorSectionTitleStyle}" />
                        </StackPanel>
                        <TextBox x:Name="TitleBox" Header="Title" />
                        <controls:TagPicker x:Name="ArtistBox" Header="Artists" Kind="Artist" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ComposerBox" Header="Composer" />
                            <TextBox x:Name="BpmBox" Header="BPM" Grid.Column="1" InputScope="Number" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE93C;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Album" Style="{StaticResource EditorSectionTitleStyle}" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:TagPicker x:Name="AlbumBox" Header="Album" Kind="Album" Multiple="False" VerticalAlignment="Top" />
                            <controls:TagPicker x:Name="AlbumArtistBox" Grid.Column="1" Header="Album artist" Kind="Artist" Multiple="False" VerticalAlignment="Top" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="YearBox" Header="Year" InputScope="Number" />
                            <TextBox x:Name="TrackBox" Header="Track" Grid.Column="1" InputScope="Number" />
                            <TextBox x:Name="TrackCountBox" Header="Tracks on album" Grid.Column="2" InputScope="Number" />
                            <TextBox x:Name="DiscBox" Header="Disc" Grid.Column="3" InputScope="Number" />
                        </Grid>
                        <controls:TagPicker x:Name="GenreBox" Header="Genres" Kind="Genre" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE90A;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Comment" Style="{StaticResource EditorSectionTitleStyle}" />
                        </StackPanel>
                        <TextBox x:Name="CommentBox" AcceptsReturn="True" TextWrapping="Wrap" Height="72" PlaceholderText="Notes about this song" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Artwork -->
        <Grid x:Name="ArtPanel" Grid.Row="2" Visibility="Collapsed" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="300" Height="300" CornerRadius="12" VerticalAlignment="Top">
                <controls:ArtImage x:Name="ArtPreview" DecodeSize="320" />
                <Image x:Name="NewArtPreview" Stretch="UniformToFill" />
                <ProgressRing x:Name="ArtProgress" IsActive="False" Width="40" Height="40" />
            </Grid>
            <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Top">
                <TextBlock Text="Album art" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="ArtInfo" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button HorizontalAlignment="Stretch" Click="OnChooseArt">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B9;" FontSize="14" /><TextBlock Text="Browse…" /></StackPanel>
                </Button>
                <Button HorizontalAlignment="Stretch" Click="OnSearchArt">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEBD3;" FontSize="14" /><TextBlock Text="Fetch image" /></StackPanel>
                </Button>
                <Button HorizontalAlignment="Stretch" Click="OnRemoveArt">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock Text="Remove" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Lyrics -->
        <Grid x:Name="LyricsPanel" Grid.Row="2" Visibility="Collapsed" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Supports plain text and synchronized LRC format." VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <ProgressRing x:Name="LyricsProgress" IsActive="False" Width="18" Height="18" />
                    <Button Click="OnDownloadLyrics">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEBD3;" FontSize="14" /><TextBlock Text="Fetch lyrics" /></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <TextBox x:Name="LyricsBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>

        <!-- File -->
        <ScrollViewer x:Name="FilePanel" Grid.Row="2" Visibility="Collapsed">
            <Grid x:Name="FileGrid" ColumnSpacing="24" RowSpacing="10" />
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ToggleSwitch x:Name="WriteToggle" OnContent="Save to file tags" OffContent="Save to library only" />
            <HyperlinkButton Grid.Column="1" HorizontalAlignment="Right" Click="OnFix">
                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xEBD3;" FontSize="13" /><TextBlock Text="Fetch…" /></StackPanel>
            </HyperlinkButton>
        </Grid>
    </Grid>
</ContentDialog>
