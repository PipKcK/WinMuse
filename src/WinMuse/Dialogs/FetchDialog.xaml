<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinMuse.Dialogs.FetchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinMuse.Controls"
    xmlns:models="using:WinMuse.Models"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="Fetch"
    PrimaryButtonText="Apply"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">980</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">920</x:Double>
    </ContentDialog.Resources>

    <!-- Scrolls in small windows so the download choices at the bottom stay reachable. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
    <Grid Width="800" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Current song -->
        <Grid ColumnSpacing="14" Padding="12" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:ArtImage x:Name="CurrentArt" Width="56" Height="56" CornerRadius="8" DecodeSize="64" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="CurrentTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CurrentSub" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CurrentFile" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock x:Name="StepText" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <InfoBar x:Name="KeyHint" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Informational"
                 Title="AcoustID" Message="Add an AcoustID API key in Settings &gt; API keys to identify songs by audio fingerprint, including files with incorrect titles." />

        <!-- Manual search -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" PlaceholderText="Search (Artist - Title)" KeyDown="OnQueryKey" />
            <Button Grid.Column="1" Click="OnSearch">
                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE721;" FontSize="13" /><TextBlock Text="Search" /></StackPanel>
            </Button>
            <Button Grid.Column="2" Click="OnAuto" ToolTipService.ToolTip="Identify automatically" AutomationProperties.Name="Identify">
                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE945;" FontSize="13" /><TextBlock Text="Identify" /></StackPanel>
            </Button>
        </Grid>

        <!-- Candidates -->
        <Grid Grid.Row="3">
            <ListView x:Name="Candidates" SelectionMode="Single" SelectionChanged="OnCandidateChanged" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:MetadataCandidate">
                        <Grid Padding="0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind Headline}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="10" Padding="8,2" Background="{StaticResource AccentGradientBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ScoreText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="Busy" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <ProgressRing x:Name="BusyRing" IsActive="True" Width="32" Height="32" />
                <TextBlock x:Name="StatusText" Text="Identifying…" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" />
            </StackPanel>
        </Grid>

        <!-- Diff of the selected candidate -->
        <Grid x:Name="DiffGrid" Grid.Row="4" ColumnSpacing="16" RowSpacing="4" />

        <!-- What else to download along with the selected match. -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="16">
            <TextBlock Text="Also download" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <CheckBox x:Name="ArtCheck" Content="Album art" IsChecked="True" />
            <CheckBox x:Name="ArtistCheck" Content="Artist photo" IsChecked="True" />
            <CheckBox x:Name="LyricsCheck" Content="Lyrics" IsChecked="True" />
            <CheckBox x:Name="GenreCheck" Content="Genre" IsChecked="True" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</ContentDialog>
