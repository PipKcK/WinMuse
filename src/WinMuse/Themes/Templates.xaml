<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="WinMuse.Themes.Templates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinMuse.Controls"
    xmlns:models="using:WinMuse.Models">

    <!-- Album card: artwork with hover lift and a play button that slides in. -->
    <DataTemplate x:Key="AlbumCardTemplate" x:DataType="models:Album">
        <StackPanel Width="176" Spacing="6" Padding="4" controls:Effects.HoverScale="1.03" controls:Effects.RevealTarget="{Binding ElementName=PlayOverlay}" Background="Transparent">
            <Grid Width="168" Height="168">
                <controls:ArtImage x:Name="Art" Source="{x:Bind ArtPath}" Seed="{x:Bind Key}" CornerRadius="10" DecodeSize="200" />
                <Button x:Name="PlayOverlay" Style="{StaticResource PlayButtonStyle}" Width="44" Height="44" CornerRadius="22"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Click="OnPlayAlbum" ToolTipService.ToolTip="Play" AutomationProperties.Name="Play">
                    <FontIcon Glyph="&#xE768;" FontSize="16" />
                </Button>
            </Grid>
            <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleStyle}" Margin="2,4,2,0" />
            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CardSubtitleStyle}" Margin="2,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Artist card: circular art. -->
    <DataTemplate x:Key="ArtistCardTemplate" x:DataType="models:Artist">
        <StackPanel Width="164" Spacing="8" Padding="6" controls:Effects.HoverScale="1.04" Background="Transparent">
            <Grid Width="148" Height="148">
                <controls:ArtImage x:Name="Art" Source="{x:Bind ArtPath}" Seed="{x:Bind Name}" CornerRadius="74" DecodeSize="160" Glyph="&#xE77B;" />
                <!-- Favorite artist badge -->
                <Border Visibility="{x:Bind IsFavorite}" Width="30" Height="30" CornerRadius="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"
                        Background="{StaticResource AccentGradientBrush}" BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderThickness="2">
                    <FontIcon Glyph="&#xEB52;" FontSize="12" Foreground="White" />
                </Border>
            </Grid>
            <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind Summary}" Style="{StaticResource CardSubtitleStyle}" HorizontalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <!-- Song card used in horizontal "shelves" on Home. -->
    <DataTemplate x:Key="SongCardTemplate" x:DataType="models:Track">
        <StackPanel Width="148" Spacing="6" Padding="4" controls:Effects.HoverScale="1.03" controls:Effects.RevealTarget="{Binding ElementName=PlayOverlay}" Background="Transparent">
            <Grid Width="140" Height="140">
                <controls:ArtImage Source="{x:Bind ArtPath}" Seed="{x:Bind AlbumKey}" CornerRadius="10" DecodeSize="160" />
                <Button x:Name="PlayOverlay" Style="{StaticResource PlayButtonStyle}" Width="40" Height="40" CornerRadius="20"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Click="OnPlayTrack">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                </Button>
            </Grid>
            <TextBlock Text="{x:Bind DisplayTitle}" Style="{StaticResource CardTitleStyle}" Margin="2,2,2,0" />
            <TextBlock Text="{x:Bind DisplayArtist}" Style="{StaticResource CardSubtitleStyle}" Margin="2,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Wide "quick pick" tile. -->
    <DataTemplate x:Key="QuickEntryTemplate" x:DataType="models:QuickEntry">
        <Grid Height="64" CornerRadius="8" Background="{ThemeResource QuickTileBrush}" BorderBrush="{ThemeResource QuickTileStrokeBrush}" BorderThickness="1"
              ColumnSpacing="12" controls:Effects.HoverScale="1.02" ToolTipService.ToolTip="{x:Bind Title}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:ArtImage Source="{x:Bind ArtPath}" Seed="{x:Bind Seed}" DecodeSize="72" CornerRadius="{x:Bind ArtCorner}" Margin="{x:Bind ArtMargin}" Glyph="{x:Bind KindGlyph}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleStyle}" />
                <!-- The kind icon tells songs and artists apart at a glance. -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="{x:Bind KindGlyph}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" AutomationProperties.Name="{x:Bind KindName}" />
                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CardSubtitleStyle}" />
                </StackPanel>
            </StackPanel>
            <FontIcon Grid.Column="2" Glyph="{x:Bind BadgeGlyph}" Visibility="{x:Bind BadgeVisibility}" FontSize="14" Margin="0,0,16,0" VerticalAlignment="Center"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" ToolTipService.ToolTip="{x:Bind BadgeTip}" />
        </Grid>
    </DataTemplate>

    <!-- Playlist card: single cover or 2x2 mosaic. -->
    <DataTemplate x:Key="PlaylistCardTemplate" x:DataType="models:Playlist">
        <StackPanel Width="176" Spacing="6" Padding="4" controls:Effects.HoverScale="1.03" controls:Effects.RevealTarget="{Binding ElementName=PlayOverlay}" Background="Transparent">
            <Grid Width="168" Height="168" CornerRadius="10">
                <controls:ArtImage Source="{x:Bind Art1, Mode=OneWay}" Seed="{x:Bind Name, Mode=OneWay}" DecodeSize="200" Glyph="&#xE90B;" />
                <Grid Visibility="{x:Bind IsMosaic, Mode=OneWay}">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <controls:ArtImage Source="{x:Bind Art1, Mode=OneWay}" DecodeSize="100" />
                    <controls:ArtImage Grid.Column="1" Source="{x:Bind Art2, Mode=OneWay}" DecodeSize="100" />
                    <controls:ArtImage Grid.Row="1" Source="{x:Bind Art3, Mode=OneWay}" DecodeSize="100" />
                    <controls:ArtImage Grid.Row="1" Grid.Column="1" Source="{x:Bind Art4, Mode=OneWay}" DecodeSize="100" />
                </Grid>
                <Border Visibility="{x:Bind IsSmart, Mode=OneWay}" Background="{StaticResource AccentGradientBrush}" CornerRadius="10" Padding="6,2" Margin="8"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE945;" FontSize="10" Foreground="White" />
                        <TextBlock Text="Smart" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Button x:Name="PlayOverlay" Style="{StaticResource PlayButtonStyle}" Width="44" Height="44" CornerRadius="22"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Click="OnPlayPlaylist">
                    <FontIcon Glyph="&#xE768;" FontSize="16" />
                </Button>
            </Grid>
            <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource CardTitleStyle}" Margin="2,4,2,0" />
            <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Style="{StaticResource CardSubtitleStyle}" Margin="2,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Genre tile: color gradient with tilted artwork. -->
    <DataTemplate x:Key="GenreTileTemplate" x:DataType="models:Genre">
        <Grid Width="240" Height="132" CornerRadius="12" controls:Effects.HoverScale="1.03">
            <controls:ArtImage Seed="{x:Bind Name}" Glyph="" />
            <Grid Width="96" Height="96" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-14,-10" CornerRadius="8" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><RotateTransform Angle="22" /></Grid.RenderTransform>
                <controls:ArtImage Source="{x:Bind Art1}" Seed="{x:Bind Name}" DecodeSize="110" />
            </Grid>
            <StackPanel Margin="16,14" VerticalAlignment="Top">
                <TextBlock Text="{x:Bind Name}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                <TextBlock Text="{x:Bind Summary}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#CCFFFFFF" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Home row cards: the artwork spans the card's full width; the card extends below it for title, artist and year. -->
    <DataTemplate x:Key="ShelfAlbumCardTemplate" x:DataType="models:Album">
        <Grid Width="174" Background="Transparent" controls:Effects.RevealTarget="{Binding ElementName=PlayOverlay}">
        <Border CornerRadius="12" Background="{StaticResource ShelfCardBrush}">
            <StackPanel>
                <Grid Height="174">
                    <Grid.Clip><RectangleGeometry Rect="0,0,174,174" /></Grid.Clip>
                    <controls:ArtImage x:Name="CardArt" Source="{x:Bind ArtPath}" Seed="{x:Bind Key}" DecodeSize="200" />
                    <Button x:Name="PlayOverlay" Style="{StaticResource PlayButtonStyle}" Width="42" Height="42" CornerRadius="21"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Click="OnPlayAlbum" ToolTipService.ToolTip="Play" AutomationProperties.Name="Play">
                        <FontIcon Glyph="&#xE768;" FontSize="15" />
                    </Button>
                </Grid>
                <StackPanel Padding="12,10,12,12" Spacing="1">
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="{x:Bind Artist}" Style="{StaticResource CardSubtitleStyle}" />
                    <TextBlock Text="{x:Bind YearText}" Style="{StaticResource CardSubtitleStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" MinHeight="16" />
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- The edge is drawn on top of the card, so artwork never covers it. -->
        <Border CornerRadius="12" BorderBrush="{StaticResource ShelfCardStrokeBrush}" BorderThickness="{StaticResource ShelfCardStrokeThickness}" IsHitTestVisible="False" />
        <!-- Press feedback: a faint neutral sheen and edge that pulse when the card or its play button is clicked (Controls/ShelfEffects). -->
        <Grid Tag="PressGlow" Opacity="0" IsHitTestVisible="False">
            <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.12" /></Grid.OpacityTransition>
            <Border CornerRadius="12" Background="{ThemeResource PressGlowFillBrush}" />
            <Border CornerRadius="12" BorderBrush="{ThemeResource PressGlowStrokeBrush}" BorderThickness="1.5" />
        </Grid>
        </Grid>
    </DataTemplate>

    <!-- Continue Listening card: the song reached, a thin bar for how much of it was heard, and where it was played from. -->
    <DataTemplate x:Key="ShelfContinueCardTemplate" x:DataType="models:ContinueItem">
        <Grid Width="174" Background="Transparent" controls:Effects.RevealTarget="{Binding ElementName=PlayOverlay}">
        <Border CornerRadius="12" Background="{StaticResource ShelfCardBrush}">
            <!-- CardContent eases in when the entry moves on to another song (HomePage.RefreshContinue). -->
            <StackPanel x:Name="CardContent">
                <Grid Height="174">
                    <Grid.Clip><RectangleGeometry Rect="0,0,174,174" /></Grid.Clip>
                    <controls:ArtImage x:Name="CardArt" Source="{x:Bind ArtPath, Mode=OneWay}" Seed="{x:Bind Seed, Mode=OneWay}" DecodeSize="200" />
                    <Button x:Name="PlayOverlay" Style="{StaticResource PlayButtonStyle}" Width="42" Height="42" CornerRadius="21"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10,10,10,14" Click="OnResumeEntry" ToolTipService.ToolTip="Resume" AutomationProperties.Name="Resume">
                        <FontIcon Glyph="&#xE768;" FontSize="15" />
                    </Button>
                    <!-- How far into the song: a slim bar along the cover's bottom edge. -->
                    <Grid VerticalAlignment="Bottom" Height="4" Background="#55000000" IsHitTestVisible="False">
                        <Rectangle HorizontalAlignment="Left" Width="{x:Bind ProgressWidth, Mode=OneWay}" Fill="{StaticResource AccentGradientBrush}" />
                    </Grid>
                </Grid>
                <StackPanel Padding="12,10,12,12" Spacing="1">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="{x:Bind Artist, Mode=OneWay}" Style="{StaticResource CardSubtitleStyle}" />
                    <TextBlock Text="{x:Bind Source, Mode=OneWay}" Style="{StaticResource CardSubtitleStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" MinHeight="16" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border CornerRadius="12" BorderBrush="{StaticResource ShelfCardStrokeBrush}" BorderThickness="{StaticResource ShelfCardStrokeThickness}" IsHitTestVisible="False" />
        <Grid Tag="PressGlow" Opacity="0" IsHitTestVisible="False">
            <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.12" /></Grid.OpacityTransition>
            <Border CornerRadius="12" Background="{ThemeResource PressGlowFillBrush}" />
            <Border CornerRadius="12" BorderBrush="{ThemeResource PressGlowStrokeBrush}" BorderThickness="1.5" />
        </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ShelfSongCardTemplate" x:DataType="models:Track">
        <Grid Width="174" Background="Transparent" controls:Effects.RevealTarget="{Binding ElementName=PlayOverlay}">
        <Border CornerRadius="12" Background="{StaticResource ShelfCardBrush}">
            <StackPanel>
                <Grid Height="174">
                    <Grid.Clip><RectangleGeometry Rect="0,0,174,174" /></Grid.Clip>
                    <controls:ArtImage x:Name="CardArt" Source="{x:Bind ArtPath}" Seed="{x:Bind AlbumKey}" DecodeSize="200" />
                    <Button x:Name="PlayOverlay" Style="{StaticResource PlayButtonStyle}" Width="42" Height="42" CornerRadius="21"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Click="OnPlayTrack" ToolTipService.ToolTip="Play" AutomationProperties.Name="Play">
                        <FontIcon Glyph="&#xE768;" FontSize="15" />
                    </Button>
                </Grid>
                <StackPanel Padding="12,10,12,12" Spacing="1">
                    <TextBlock Text="{x:Bind DisplayTitle}" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="{x:Bind DisplayArtist}" Style="{StaticResource CardSubtitleStyle}" />
                    <TextBlock Text="{x:Bind YearText}" Style="{StaticResource CardSubtitleStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" MinHeight="16" />
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- The edge is drawn on top of the card, so artwork never covers it. -->
        <Border CornerRadius="12" BorderBrush="{StaticResource ShelfCardStrokeBrush}" BorderThickness="{StaticResource ShelfCardStrokeThickness}" IsHitTestVisible="False" />
        <!-- Press feedback: a faint neutral sheen and edge that pulse when the card or its play button is clicked (Controls/ShelfEffects). -->
        <Grid Tag="PressGlow" Opacity="0" IsHitTestVisible="False">
            <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.12" /></Grid.OpacityTransition>
            <Border CornerRadius="12" Background="{ThemeResource PressGlowFillBrush}" />
            <Border CornerRadius="12" BorderBrush="{ThemeResource PressGlowStrokeBrush}" BorderThickness="1.5" />
        </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
