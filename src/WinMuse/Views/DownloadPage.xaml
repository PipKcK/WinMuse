<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinMuse.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinMuse.Views"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <Style x:Key="Card" TargetType="Grid">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24,20" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel x:Name="Root" Padding="36,28,36,40" MaxWidth="820" HorizontalAlignment="Stretch" Spacing="20">
            <!-- Title, like the other pages. -->
            <StackPanel Spacing="2">
                <TextBlock Text="Download" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Paste a link to add a song to your library." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- mdown.exe missing -->
            <InfoBar x:Name="ToolMissingBar" IsClosable="False" Severity="Warning" Title="Downloader not installed">
                <InfoBar.ActionButton>
                    <Button Content="Open folder" Click="OnOpenToolFolder" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- The main card: a soft accent wash, one wide link field with the action beside it, and where it saves. -->
            <Grid CornerRadius="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Rectangle IsHitTestVisible="False" Opacity="0.16">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="{ThemeResource SystemAccentColor}" />
                            <GradientStop Offset="0.7" Color="Transparent" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel Padding="28,26,28,24" Spacing="18">
                    <!-- Link field: icon, URL, then the Download button in the same row. -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid CornerRadius="12" Height="48" Background="{ThemeResource ControlFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE71B;" FontSize="16" Margin="16,0,4,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="UrlBox" Grid.Column="1" PlaceholderText="Paste a song link (https://…)" KeyDown="OnUrlKeyDown" TextChanged="OnUrlChanged"
                                     VerticalAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="15"
                                     AutomationProperties.Name="Song link">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                </TextBox.Resources>
                            </TextBox>
                        </Grid>
                        <Button x:Name="DownloadButton" Grid.Column="1" Style="{StaticResource PillButtonStyle}" Height="48" Padding="22,0" Click="OnDownload" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE896;" FontSize="15" /><TextBlock Text="Download" /></StackPanel>
                        </Button>
                    </Grid>

                    <!-- Where it goes, and what happens next. -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Saves to " /><Run x:Name="FolderRun" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </TextBlock>
                        <HyperlinkButton Grid.Column="2" Content="Change" Click="OnBrowseFolder" Padding="4,2" />
                    </Grid>
                    <TextBlock x:Name="FolderBox" Visibility="Collapsed" />

                    <StackPanel x:Name="ProgressPanel" Spacing="8" Visibility="Collapsed">
                        <Grid>
                            <TextBlock x:Name="ProgressText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,90,0" VerticalAlignment="Center" />
                            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" Visibility="Collapsed" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar IsIndeterminate="True" />
                    </StackPanel>

                    <StackPanel x:Name="HintText" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Downloaded songs join your library and are fetched (details, cover and lyrics) automatically."
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Error -->
            <Grid x:Name="ErrorCard" Style="{StaticResource Card}" Visibility="Collapsed"
                  Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEB90;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Grid.Column="1" Text="Download failed" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Click="OnCopyError" ToolTipService.ToolTip="Copy the error code and message">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="13" /><TextBlock x:Name="CopyText" Text="Copy" /></StackPanel>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Content="&#xE711;" FontSize="12" Click="OnDismissError"
                                ToolTipService.ToolTip="Dismiss" AutomationProperties.Name="Dismiss" />
                    </Grid>
                    <TextBox x:Name="ErrorBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="240"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Grid>

            <!-- Secret file: a quiet status row. -->
            <Grid Padding="16,12" CornerRadius="12" ColumnSpacing="14" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="36" Height="36" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <FontIcon Glyph="&#xE72E;" FontSize="16" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="Secret file" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="SecretText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="SecretButton" Click="OnUploadSecret">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE898;" FontSize="13" /><TextBlock x:Name="SecretButtonText" Text="Upload" /></StackPanel>
                    </Button>
                    <Button x:Name="RemoveSecretButton" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Content="&#xE74D;" FontSize="14" Click="OnRemoveSecret"
                            ToolTipService.ToolTip="Remove secret file" AutomationProperties.Name="Remove secret file" />
                </StackPanel>
            </Grid>

            <!-- This session's downloads -->
            <TextBlock x:Name="HistoryHeader" Text="Recent Downloads" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" Margin="2,8,0,0" Visibility="Collapsed" />
            <ItemsControl x:Name="History">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DownloadEntry">
                        <Grid Padding="16,12" Margin="0,0,0,6" ColumnSpacing="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="14" Foreground="{x:Bind Brush, Mode=OneWay}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Url}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
