<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinMuse.Views.MiniPlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinMuse.Controls"
    xmlns:helpers="using:WinMuse.Helpers"
    Title="Music">

    <Grid x:Name="Root">
        <!-- Album art washed into the background -->
        <controls:ArtImage x:Name="Backdrop" DecodeSize="10" Opacity="0.9"
                           Source="{x:Bind helpers:Conv.ArtOf(Player.CurrentTrack), Mode=OneWay}"
                           Seed="{x:Bind helpers:Conv.SeedOf(Player.CurrentTrack), Mode=OneWay}" />
        <Rectangle Fill="{ThemeResource NowPlayingScrimBrush}" />

        <Grid x:Name="DragArea" Height="32" VerticalAlignment="Top" Background="Transparent" />

        <Grid Padding="16,36,16,14" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:ArtImage x:Name="Art" Width="104" Height="104" CornerRadius="10" DecodeSize="128" VerticalAlignment="Center"
                               Source="{x:Bind helpers:Conv.ArtOf(Player.CurrentTrack), Mode=OneWay}"
                               Seed="{x:Bind helpers:Conv.SeedOf(Player.CurrentTrack), Mode=OneWay}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind helpers:Conv.TitleOf(Player.CurrentTrack), Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15"
                           Foreground="{ThemeResource NowPlayingTextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Text="{x:Bind helpers:Conv.ArtistOf(Player.CurrentTrack), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource NowPlayingSubtleTextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <ProgressBar Value="{x:Bind Player.Position, Mode=OneWay}" Maximum="{x:Bind helpers:Conv.Max1(Player.Duration), Mode=OneWay}" Margin="0,10,0,6" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Style="{StaticResource IconButtonStyle}" Width="36" Height="36" Content="&#xE892;" Click="OnPrevious" Foreground="{ThemeResource NowPlayingTextBrush}" />
                    <Button Style="{StaticResource PlayButtonStyle}" Width="40" Height="40" CornerRadius="20" Click="OnPlayPause">
                        <FontIcon Glyph="{x:Bind helpers:Conv.PlayGlyph(Player.IsPlaying), Mode=OneWay}" FontSize="15" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Width="36" Height="36" Content="&#xE893;" Click="OnNext" Foreground="{ThemeResource NowPlayingTextBrush}" />
                    <Button Style="{StaticResource IconButtonStyle}" Width="36" Height="36" Content="&#xEE47;" Click="OnExpand" Foreground="{ThemeResource NowPlayingSubtleTextBrush}"
                            ToolTipService.ToolTip="Restore" AutomationProperties.Name="Restore" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
