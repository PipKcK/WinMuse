<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinMuse.Views.AlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:WinMuse.Helpers"
    NavigationCacheMode="Enabled">

    <Grid RowDefinitions="Auto,*">
        <Grid x:Name="Header" helpers:HeaderWrap.IsEnabled="True" Padding="36,28,36,12">
            <StackPanel Spacing="2">
                <TextBlock Text="Albums" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="CountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox x:Name="FilterBox" PlaceholderText="Search albums…" Width="220" VerticalAlignment="Center" TextChanged="OnFilter" />
                <ComboBox x:Name="SortBox" SelectionChanged="OnSortChanged" MinWidth="160" VerticalAlignment="Center">
                    <x:String>A–Z</x:String>
                    <x:String>Artist</x:String>
                    <x:String>Release year</x:String>
                    <x:String>Recently added</x:String>
                    <x:String>Most played</x:String>
                </ComboBox>
                <Button Style="{StaticResource GhostPillButtonStyle}" Click="OnNewAlbum" ToolTipService.ToolTip="Create an album from songs in your library" AutomationProperties.Name="Create an album from songs in your library">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="New Album" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <GridView x:Name="Grid" Grid.Row="1" Padding="32,4,24,24"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick" RightTapped="OnRightTapped"
                  ItemTemplate="{StaticResource AlbumCardTemplate}"
                  ItemContainerStyle="{StaticResource CardGridViewItemStyle}" />
    </Grid>
</Page>
