<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinMuse.Views.SongsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinMuse.Controls">

    <Grid RowDefinitions="Auto,*">
        <Grid x:Name="Header" Padding="36,28,36,16" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:ArtImage x:Name="HeaderArt" Width="96" Height="96" CornerRadius="12" DecodeSize="120" Visibility="Collapsed" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="TitleText" Text="Songs" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SubtitleText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox x:Name="FilterBox" PlaceholderText="Search songs…" Width="200" TextChanged="OnFilterChanged" VerticalAlignment="Center" />
                <Button Style="{StaticResource GhostPillButtonStyle}" Click="OnShuffle">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B1;" FontSize="14" /><TextBlock Text="Shuffle" /></StackPanel>
                </Button>
                <Button Style="{StaticResource PillButtonStyle}" Click="OnPlayAll">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock Text="Play all" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <controls:TrackList x:Name="Tracks" Grid.Row="1" EmptyMessage="No songs. Add a library folder in Settings." />
    </Grid>
</Page>
