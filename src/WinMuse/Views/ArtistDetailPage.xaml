<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinMuse.Views.ArtistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinMuse.Controls">

    <ScrollViewer>
        <StackPanel Padding="0,0,0,32" Spacing="24">
            <Grid x:Name="Header" Height="300">
                <controls:ArtImage x:Name="Backdrop" DecodeSize="12" Opacity="0.5" Glyph="" />
                <Rectangle Fill="{ThemeResource LayerFillColorDefaultBrush}" Opacity="0.6" />
                <Grid Padding="36,36,36,24" ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:ArtImage x:Name="Portrait" Width="196" Height="196" CornerRadius="98" DecodeSize="240" Glyph="&#xE77B;" />
                    <StackPanel x:Name="Info" Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                        <TextBlock Text="ARTIST" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CharacterSpacing="120" />
                        <TextBlock x:Name="NameText" Style="{StaticResource DisplayTextBlockStyle}" FontSize="52" FontWeight="Bold" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" MaxLines="2" />
                        <TextBlock x:Name="SummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,0">
                            <Button Style="{StaticResource PillButtonStyle}" Click="OnPlay">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock Text="Play" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostPillButtonStyle}" Click="OnShuffle">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B1;" FontSize="14" /><TextBlock Text="Shuffle" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostPillButtonStyle}" Click="OnAllSongs" Content="All songs" />
                            <Button x:Name="FavoriteButton" Style="{StaticResource IconButtonStyle}" Content="&#xEB51;" Click="OnFavorite" AutomationProperties.Name="Favorite" />
                            <Button x:Name="PinButton" Style="{StaticResource IconButtonStyle}" Content="&#xE718;" Click="OnPin" AutomationProperties.Name="Pin to Quick access" />
                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE70F;" Click="OnEdit" ToolTipService.ToolTip="Edit artist" AutomationProperties.Name="Edit artist" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <StackPanel Padding="36,0" x:Name="PopularSection">
                <TextBlock Text="Popular" Style="{StaticResource SectionTitleStyle}" />
                <controls:TrackList x:Name="Popular" MaxHeight="400" />
            </StackPanel>

            <StackPanel Padding="36,0">
                <TextBlock Text="Albums" Style="{StaticResource SectionTitleStyle}" />
                <!-- Non-virtualizing on purpose: this sits inside the page ScrollViewer. -->
                <ItemsControl x:Name="Albums" Margin="-4,0,0,0" ItemTemplate="{StaticResource AlbumCardTemplate}" Tapped="OnAlbumTapped" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="188" ItemHeight="250" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
