<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinMuse.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinMuse.Controls">

    <Page.Resources>
        <ItemsPanelTemplate x:Key="ShelfPanel">
            <ItemsStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel x:Name="Header" Padding="36,28,36,8" Spacing="2">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="SummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Padding="36,8,36,0" Spacing="16">
            <StackPanel x:Name="ArtistsSection">
                <TextBlock Text="Artists" Style="{StaticResource SectionTitleStyle}" />
                <ListView x:Name="ArtistsList" ItemsPanel="{StaticResource ShelfPanel}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnArtistClick"
                          ItemTemplate="{StaticResource ArtistCardTemplate}" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollMode="Disabled" Margin="-12,0,0,0" />
            </StackPanel>
            <StackPanel x:Name="AlbumsSection">
                <TextBlock Text="Albums" Style="{StaticResource SectionTitleStyle}" />
                <ListView x:Name="AlbumsList" ItemsPanel="{StaticResource ShelfPanel}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnAlbumClick"
                          ItemTemplate="{StaticResource AlbumCardTemplate}" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollMode="Disabled" Margin="-12,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="SongsTitle" Text="Songs" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,0" />
        </StackPanel>

        <controls:TrackList x:Name="Songs" Grid.Row="2" EmptyMessage="No matching songs" />
    </Grid>
</Page>
