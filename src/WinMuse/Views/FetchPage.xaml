<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinMuse.Views.FetchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinMuse.Controls"
    xmlns:local="using:WinMuse.Views">

    <Page.Resources>
        <!-- One status cell: icon + label, colored by state. -->
        <DataTemplate x:Key="StatusCell" x:DataType="local:SourceStatus">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Tooltip}">
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" Foreground="{x:Bind Brush}" />
                <TextBlock Text="{x:Bind Label}" Foreground="{x:Bind Brush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid x:Name="Header" Padding="36,28,36,8">
            <StackPanel Spacing="2">
                <TextBlock Text="Fetch" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox x:Name="FilterBox" SelectionChanged="OnFilterChanged" MinWidth="170" VerticalAlignment="Center">
                    <x:String>All songs</x:String>
                    <x:String>Incomplete</x:String>
                    <x:String>Edited by you</x:String>
                    <x:String>Complete</x:String>
                </ComboBox>
                <Button x:Name="SyncButton" Style="{StaticResource PillButtonStyle}" Click="OnSync">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEBD3;" FontSize="14" /><TextBlock x:Name="SyncText" Text="Fetch" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Column header -->
        <Grid Grid.Row="1" Height="36" Padding="44,0,44,0" ColumnSpacing="12" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Song" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Metadata" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="Album art" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="Artist image" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="Lyrics" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="5" Text="Fetch status" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
        </Grid>

        <ListView x:Name="List" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="False" Padding="24,4,24,24" RightTapped="OnRightTapped">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="20,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SourceRow">
                    <Grid Height="56" ColumnSpacing="12" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:ArtImage Width="40" Height="40" CornerRadius="6" DecodeSize="48" Source="{x:Bind Track.ArtPath}" Seed="{x:Bind Track.AlbumKey}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Track.DisplayTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <TextBlock Text="{x:Bind Track.DisplayArtist}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Content="{x:Bind Metadata}" ContentTemplate="{StaticResource StatusCell}" VerticalAlignment="Center" />
                        <ContentPresenter Grid.Column="2" Content="{x:Bind AlbumArt}" ContentTemplate="{StaticResource StatusCell}" VerticalAlignment="Center" />
                        <ContentPresenter Grid.Column="3" Content="{x:Bind ArtistImage}" ContentTemplate="{StaticResource StatusCell}" VerticalAlignment="Center" />
                        <ContentPresenter Grid.Column="4" Content="{x:Bind Lyrics}" ContentTemplate="{StaticResource StatusCell}" VerticalAlignment="Center" />
                        <Border Grid.Column="5" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{x:Bind FlagBackground}">
                            <TextBlock Text="{x:Bind FlagText}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind FlagForeground}" />
                        </Border>
                        <Button Grid.Column="6" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Content="&#xEBD3;" FontSize="14" Click="OnSyncRow"
                                IsEnabled="{x:Bind CanSync}" ToolTipService.ToolTip="{x:Bind SyncTooltip}" AutomationProperties.Name="Fetch this song" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="Empty" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
            <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="EmptyText" Text="No songs" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
