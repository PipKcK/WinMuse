<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinMuse.Views.GenresPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <Grid RowDefinitions="Auto,*">
        <Grid x:Name="Header" Padding="36,28,36,12">
            <StackPanel Spacing="2">
                <TextBlock Text="Genres" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="CountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox x:Name="FilterBox" PlaceholderText="Search genres…" Width="220" VerticalAlignment="Center" TextChanged="OnFilter" />
                <ComboBox x:Name="SortBox" SelectionChanged="OnSortChanged" MinWidth="160" VerticalAlignment="Center"
                          AutomationProperties.Name="Sort genres" ToolTipService.ToolTip="Sort genres">
                    <x:String>Most songs</x:String>
                    <x:String>A–Z</x:String>
                </ComboBox>
                <Button Style="{StaticResource GhostPillButtonStyle}" Click="OnNewGenre" ToolTipService.ToolTip="Create a genre from songs in your library" AutomationProperties.Name="New Genre">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="New Genre" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <GridView x:Name="Grid" Grid.Row="1" Padding="32,4,24,24"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick" RightTapped="OnRightTapped"
                  ItemTemplate="{StaticResource GenreTileTemplate}"
                  ItemContainerStyle="{StaticResource CardGridViewItemStyle}" />
    </Grid>
</Page>
