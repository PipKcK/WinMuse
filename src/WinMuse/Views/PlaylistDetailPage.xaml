<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinMuse.Views.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinMuse.Controls">

    <Grid RowDefinitions="Auto,*">
        <Grid x:Name="Header" Height="290">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.35">
                    <GradientStop x:Name="Stop1" Offset="0" Color="#FF6D5DFC" />
                    <GradientStop x:Name="Stop2" Offset="1" Color="Transparent" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid Padding="36,32,36,24" ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="CoverHost" Width="208" Height="208" CornerRadius="14">
                    <controls:ArtImage x:Name="Cover" DecodeSize="260" Glyph="&#xE90B;" />
                    <Grid x:Name="Mosaic" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <controls:ArtImage x:Name="M1" DecodeSize="120" />
                        <controls:ArtImage x:Name="M2" Grid.Column="1" DecodeSize="120" />
                        <controls:ArtImage x:Name="M3" Grid.Row="1" DecodeSize="120" />
                        <controls:ArtImage x:Name="M4" Grid.Row="1" Grid.Column="1" DecodeSize="120" />
                    </Grid>
                </Grid>
                <StackPanel x:Name="Info" Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                    <TextBlock x:Name="KindText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CharacterSpacing="120" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource TitleLargeTextBlockStyle}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DescText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock x:Name="SummaryText" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,0">
                        <Button Style="{StaticResource PillButtonStyle}" Click="OnPlay">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock Text="Play" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostPillButtonStyle}" Click="OnShuffle">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B1;" FontSize="14" /><TextBlock Text="Shuffle" /></StackPanel>
                        </Button>
                        <Button x:Name="EditButton" Style="{StaticResource IconButtonStyle}" Content="&#xE70F;" Click="OnEdit" ToolTipService.ToolTip="Edit playlist" AutomationProperties.Name="Edit playlist" />
                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE712;" Click="OnMore" ToolTipService.ToolTip="More" AutomationProperties.Name="More" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
        <controls:TrackList x:Name="Tracks" Grid.Row="1" EmptyMessage="This playlist is empty. Right-click a song and select Add to playlist." />
    </Grid>
</Page>
