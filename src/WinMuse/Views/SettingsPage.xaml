<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinMuse.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:WinMuse.Controls"
    xmlns:helpers="using:WinMuse.Helpers">

    <Page.Resources>
        <Style x:Key="GroupHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="2,28,0,6" />
        </Style>
        <!-- Secondary options that belong to the card above them. -->
        <Style x:Key="SubCard" TargetType="tk:SettingsCard">
            <Setter Property="Margin" Value="40,0,0,0" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel x:Name="Root" Padding="36,28,36,48" MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="4">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,8" />

            <!-- ================= Library ================= -->
            <TextBlock Text="Library" Style="{StaticResource GroupHeader}" />
            <tk:SettingsExpander Header="Library folders" Description="Folders included in your library. Changes are detected automatically." IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8B7;" /></tk:SettingsExpander.HeaderIcon>
                <Button AutomationProperties.Name="Add folder" Style="{StaticResource AccentButtonStyle}" Click="OnAddFolder">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="Add folder" /></StackPanel>
                </Button>
                <tk:SettingsExpander.ItemsHeader>
                    <StackPanel>
                        <ItemsControl ItemsSource="{x:Bind Vm.Folders}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid Padding="58,10,44,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8B7;" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" Padding="8,6" Click="OnRemoveFolder" Tag="{x:Bind}" ToolTipService.ToolTip="Remove from library"
                                                AutomationProperties.Name="Remove from library" AutomationProperties.HelpText="{x:Bind}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No folders added." Margin="58,10,44,10" Opacity="0.7" Visibility="{x:Bind Vm.HasNoFolders, Mode=OneWay}" />
                    </StackPanel>
                </tk:SettingsExpander.ItemsHeader>
            </tk:SettingsExpander>
            <tk:SettingsCard Header="Scan library" Description="Check library folders for new, changed and removed files.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE72C;" /></tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind Vm.ScanStatus, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="Scan" Click="OnRescan" />
                </StackPanel>
            </tk:SettingsCard>
            <tk:SettingsCard Header="Removed songs" Description="Songs removed from the library are hidden but stay on your PC. Restore brings them back.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE777;" /></tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind Vm.RemovedText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="Restore" Click="OnRestoreRemoved" IsEnabled="{x:Bind Vm.CanRestore, Mode=OneWay}" />
                </StackPanel>
            </tk:SettingsCard>

            <!-- ================= Appearance ================= -->
            <TextBlock Text="Appearance" Style="{StaticResource GroupHeader}" />
            <tk:SettingsCard Header="Title bar logo" Description="The logo at the top left. Rings and Simple take on the accent color; App icon shows the app's own icon as it is.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xECAA;" /></tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleButton IsChecked="{x:Bind Vm.IsLogoRings, Mode=OneWay}" Click="OnLogoStyle" Tag="Rings" Padding="10,6" AutomationProperties.Name="Rings">
                        <StackPanel Orientation="Horizontal" Spacing="8"><controls:AppLogo Width="22" Height="22" LogoStyle="Rings" /><TextBlock Text="Rings" VerticalAlignment="Center" /></StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{x:Bind Vm.IsLogoSimple, Mode=OneWay}" Click="OnLogoStyle" Tag="Simple" Padding="10,6" AutomationProperties.Name="Simple">
                        <StackPanel Orientation="Horizontal" Spacing="8"><controls:AppLogo Width="22" Height="22" LogoStyle="Simple" /><TextBlock Text="Simple" VerticalAlignment="Center" /></StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{x:Bind Vm.IsLogoImage, Mode=OneWay}" Click="OnLogoStyle" Tag="Image" Padding="10,6" AutomationProperties.Name="App icon">
                        <StackPanel Orientation="Horizontal" Spacing="8"><controls:AppLogo Width="22" Height="22" LogoStyle="Image" /><TextBlock Text="App icon" VerticalAlignment="Center" /></StackPanel>
                    </ToggleButton>
                </StackPanel>
            </tk:SettingsCard>
            <tk:SettingsCard Header="Theme" Description="Light or dark appearance. System default follows Windows. OLED uses true black, which saves power on OLED screens.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></tk:SettingsCard.HeaderIcon>
                <ComboBox SelectedIndex="{x:Bind Vm.ThemeIndex, Mode=TwoWay}" MinWidth="180" AutomationProperties.Name="Theme">
                    <x:String>System default</x:String>
                    <x:String>Light</x:String>
                    <x:String>Dark</x:String>
                    <x:String>OLED</x:String>
                </ComboBox>
            </tk:SettingsCard>
            <tk:SettingsCard Header="Accent color" Description="Color used for controls and highlights.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE771;" /></tk:SettingsCard.HeaderIcon>
                <ComboBox SelectedIndex="{x:Bind Vm.AccentSourceIndex, Mode=TwoWay}" MinWidth="180" AutomationProperties.Name="Accent color">
                    <x:String>Windows</x:String>
                    <x:String>Custom</x:String>
                    <x:String>Album art</x:String>
                </ComboBox>
            </tk:SettingsCard>
            <tk:SettingsCard Style="{StaticResource SubCard}" Header="Custom color" HorizontalContentAlignment="Left" ContentAlignment="Vertical"
                             Visibility="{x:Bind Vm.ShowCustomAccent, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <StackPanel x:Name="AccentSwatches" Orientation="Horizontal" Spacing="8" />
                    <ColorPicker x:Name="AccentPicker" ColorSpectrumShape="Ring" IsAlphaEnabled="False" IsMoreButtonVisible="True" ColorChanged="OnAccentPicked" />
                </StackPanel>
            </tk:SettingsCard>

            <tk:SettingsExpander Header="Background" Description="{x:Bind Vm.BackgroundDescription, Mode=OneWay}" IsEnabled="{x:Bind Vm.IsBackgroundAvailable, Mode=OneWay}">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8B9;" /></tk:SettingsExpander.HeaderIcon>
                <ComboBox SelectedIndex="{x:Bind Vm.BackgroundModeIndex, Mode=TwoWay}" MinWidth="180" AutomationProperties.Name="Background">
                    <x:String>None</x:String>
                    <x:String>Album art</x:String>
                    <x:String>Gradient</x:String>
                    <x:String>Image</x:String>
                </ComboBox>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="Intensity" Visibility="{x:Bind Vm.ShowIntensity, Mode=OneWay}">
                        <Slider Value="{x:Bind Vm.BackgroundIntensity, Mode=TwoWay}" Minimum="10" Maximum="100" Width="220" AutomationProperties.Name="Intensity" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Animation" Visibility="{x:Bind Vm.ShowIntensity, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind Vm.AnimateBackground, Mode=TwoWay}" AutomationProperties.Name="Animation" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Gradient colors" Visibility="{x:Bind Vm.ShowGradientColors, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Width="44" Height="32" Tag="1" Click="OnGradientColor" AutomationProperties.Name="Gradient color 1"
                                    Background="{x:Bind helpers:Conv.Brush(Vm.GradientColor1), Mode=OneWay}" />
                            <Button Width="44" Height="32" Tag="2" Click="OnGradientColor" AutomationProperties.Name="Gradient color 2"
                                    Background="{x:Bind helpers:Conv.Brush(Vm.GradientColor2), Mode=OneWay}" />
                            <Button Width="44" Height="32" Tag="3" Click="OnGradientColor" AutomationProperties.Name="Gradient color 3"
                                    Background="{x:Bind helpers:Conv.Brush(Vm.GradientColor3), Mode=OneWay}" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Image" Visibility="{x:Bind Vm.ShowImageOptions, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="80" Height="45" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Image Source="{x:Bind helpers:Conv.Thumbnail(Vm.WallpaperPath, 160), Mode=OneWay}" Stretch="UniformToFill" AutomationProperties.Name="Background image preview" />
                            </Border>
                            <Button Content="Browse…" Click="OnPickWallpaper" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Blur style" Description="{x:Bind Vm.BlurStyleDescription, Mode=OneWay}" Visibility="{x:Bind Vm.ShowImageOptions, Mode=OneWay}">
                        <ComboBox SelectedIndex="{x:Bind Vm.BlurStyleIndex, Mode=TwoWay}" MinWidth="180" AutomationProperties.Name="Blur style">
                            <x:String>Gaussian</x:String>
                            <x:String>Lens</x:String>
                            <x:String>Frosted glass</x:String>
                            <x:String>Motion</x:String>
                        </ComboBox>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Blur" Visibility="{x:Bind Vm.ShowImageOptions, Mode=OneWay}">
                        <Slider Value="{x:Bind Vm.WallpaperBlur, Mode=TwoWay}" Minimum="0" Maximum="100" Width="220" AutomationProperties.Name="Blur" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Dim" Visibility="{x:Bind Vm.ShowImageOptions, Mode=OneWay}">
                        <Slider Value="{x:Bind Vm.WallpaperDim, Mode=TwoWay}" Minimum="0" Maximum="90" Width="220" AutomationProperties.Name="Dim" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <tk:SettingsExpander Header="Visualizer" Description="Audio spectrum that moves with the music, on the Now Playing screen and behind the player bar.">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE9D9;" /></tk:SettingsExpander.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind Vm.ShowVisualizer, Mode=TwoWay}" AutomationProperties.Name="Visualizer" />
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="Behind the player bar" Description="Show the spectrum underneath the player bar at the bottom of the window."
                                     Visibility="{x:Bind Vm.ShowVisualizer, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind Vm.ShowBarVisualizer, Mode=TwoWay}" AutomationProperties.Name="Behind the player bar" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Style" Description="Shape of the spectrum on the Now Playing screen." Visibility="{x:Bind Vm.ShowVisualizer, Mode=OneWay}">
                        <ComboBox SelectedIndex="{x:Bind Vm.VisualizerStyleIndex, Mode=TwoWay}" MinWidth="160" AutomationProperties.Name="Visualizer style">
                            <x:String>Bars</x:String>
                            <x:String>Mirrored</x:String>
                            <x:String>Lines</x:String>
                        </ComboBox>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <tk:SettingsCard Header="Card style" Description="Look of the album and song cards in the rows on Home. Glass: frosted and see-through. Smoke: deep, half-transparent black. Slate: cool blue-gray. Elevated: lighter, so cards seem to float. Outline: no fill, just an edge.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8A9;" /></tk:SettingsCard.HeaderIcon>
                <ComboBox SelectedIndex="{x:Bind Vm.CardColorIndex, Mode=TwoWay}" MinWidth="180" AutomationProperties.Name="Card style">
                    <x:String>Neutral gray</x:String>
                    <x:String>Glass</x:String>
                    <x:String>Smoke</x:String>
                    <x:String>Slate</x:String>
                    <x:String>Elevated</x:String>
                    <x:String>Outline</x:String>
                    <x:String>None</x:String>
                </ComboBox>
            </tk:SettingsCard>
            <tk:SettingsCard Header="Playing song highlight" Description="Animated border around the song that is playing, in every song list.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7B3;" /></tk:SettingsCard.HeaderIcon>
                <ComboBox SelectedIndex="{x:Bind Vm.PlayingHighlightIndex, Mode=TwoWay}" MinWidth="180" AutomationProperties.Name="Playing song highlight">
                    <x:String>Off</x:String>
                    <x:String>Accent color</x:String>
                    <x:String>Rainbow</x:String>
                </ComboBox>
            </tk:SettingsCard>
            <tk:SettingsCard Header="Queue panel" Description="Show the upcoming songs panel above the player.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8FD;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind Vm.ShowQueuePanel, Mode=TwoWay}" AutomationProperties.Name="Queue panel" />
            </tk:SettingsCard>

            <!-- ================= Playback ================= -->
            <TextBlock Text="Playback" Style="{StaticResource GroupHeader}" />
            <tk:SettingsCard Header="Output device" Description="Speakers or headphones that play the music.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F5;" /></tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="DeviceBox" SelectionChanged="OnDeviceChanged" MinWidth="240" DisplayMemberPath="Name" AutomationProperties.Name="Output device" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Match equalizer to genre" Description="Use the preset that suits each song's genre (Rock, Pop, Electronic, Jazz and more). Songs with an equalizer saved for them keep theirs.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9E9;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind Vm.EqMatchGenre, Mode=TwoWay}" AutomationProperties.Name="Match equalizer to genre" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Gapless playback" Description="Preload the next track to remove silence between tracks.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8EE;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind Vm.Gapless, Mode=TwoWay}" AutomationProperties.Name="Gapless playback" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Crossfade" Description="Overlap the end of each track with the start of the next.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8AB;" /></tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind Vm.CrossfadeText, Mode=OneWay}" VerticalAlignment="Center" MinWidth="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Slider Value="{x:Bind Vm.CrossfadeSeconds, Mode=TwoWay}" Minimum="0" Maximum="12" StepFrequency="0.5" Width="200" AutomationProperties.Name="Crossfade" />
                </StackPanel>
            </tk:SettingsCard>
            <tk:SettingsCard Header="Output format">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8D6;" /></tk:SettingsCard.HeaderIcon>
                <TextBlock Text="{x:Bind Vm.OutputDescription, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="360" />
            </tk:SettingsCard>

            <!-- ================= Metadata ================= -->
            <TextBlock Text="Metadata" Style="{StaticResource GroupHeader}" />
            <tk:SettingsCard Header="Automatic metadata" Description="Identify new songs and fill in their details when they are added to the library. Your later edits are preserved.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind Vm.AutoFixMetadata, Mode=TwoWay}" AutomationProperties.Name="Automatic metadata" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Automatic lyrics" Description="Download synchronized lyrics from LRCLIB. They're stored with your library, never next to your songs.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8BD;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind Vm.AutoFetchLyrics, Mode=TwoWay}" AutomationProperties.Name="Automatic lyrics" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Download media" Description="Download missing album art and artist photos.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEB9F;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind Vm.AutoFetchArt, Mode=TwoWay}" AutomationProperties.Name="Download media" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Fetch" Description="Download metadata, album art, artist images and lyrics for every song that is incomplete or was edited by you. Complete songs are skipped. Edits you made are replaced.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEBD3;" /></tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind Vm.FetchStatus, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="{x:Bind Vm.FetchButtonText, Mode=OneWay}" Click="OnFixAll" />
                </StackPanel>
            </tk:SettingsCard>
            <!-- ================= Your music files ================= -->
            <!-- Music files are never changed unless allowed here (enforced in MetadataEditService and LibraryService). -->
            <TextBlock Text="Your music files" Style="{StaticResource GroupHeader}" />
            <TextBlock Text="Your music files stay unchanged unless you allow it here. Edits, downloaded album art and lyrics are kept in your library."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="2,0,0,8" />
            <tk:SettingsExpander x:Name="FileChangesCard" Header="Change music files"
                                 Description="Write your edits (titles, artists, albums, album art, lyrics) into the songs' tags, so other apps and devices see them too.">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8A5;" /></tk:SettingsExpander.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind Vm.AllowFileChanges, Mode=TwoWay}" Toggled="OnFileChangesToggled" AutomationProperties.Name="Change music files" />
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="Save edits to" Description="{x:Bind Vm.WriteModeDescription, Mode=OneWay}" Visibility="{x:Bind Vm.AllowFileChanges, Mode=OneWay}">
                        <ComboBox SelectedIndex="{x:Bind Vm.WriteModeIndex, Mode=TwoWay}" MinWidth="200" AutomationProperties.Name="Save edits to">
                            <x:String>App only</x:String>
                            <x:String>Files only</x:String>
                            <x:String>Ask each time</x:String>
                        </ComboBox>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>
            <tk:SettingsCard Header="Allow deleting files" Description="Adds Delete file to the song menu. Deleted songs go to the Recycle Bin, where you can restore them.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE74D;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind Vm.AllowDeleteFiles, Mode=TwoWay}" AutomationProperties.Name="Allow deleting files" />
            </tk:SettingsCard>

            <!-- ================= API keys ================= -->
            <TextBlock Text="API keys" Style="{StaticResource GroupHeader}" />
            <TextBlock Text="Optional free keys that improve song identification. Each key is verified automatically after you paste it."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="2,0,0,8" />

            <tk:SettingsExpander Header="AcoustID" Description="Identifies songs by audio fingerprint, including files with incorrect tags.">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8D7;" /></tk:SettingsExpander.HeaderIcon>
                <controls:ApiKeyField x:Name="AcoustIdKey" />
                <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="How to get a free key" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    1. Open the AcoustID application page and sign in (a free account).<LineBreak />
                                    2. Enter an application name, for example "Music Player", and version "1.0", then select Register.<LineBreak />
                                    3. Copy the API key that is shown and paste it above.
                                </TextBlock>
                                <HyperlinkButton Content="Open acoustid.org/new-application" NavigateUri="https://acoustid.org/new-application" Padding="0" />
                            </StackPanel>
                        </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <tk:SettingsExpander Header="YouTube Data API" Description="Last-resort source for artist, title, artist images and album art. Free quota: 10,000 units per day.">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE714;" /></tk:SettingsExpander.HeaderIcon>
                <controls:ApiKeyField x:Name="YouTubeKey" />
                <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="How to get a free key" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    1. Open the Google Cloud Console and sign in with a Google account.<LineBreak />
                                    2. Create a project, for example "Music Player".<LineBreak />
                                    3. Go to APIs and Services &gt; Library, search for "YouTube Data API v3" and select Enable.<LineBreak />
                                    4. Go to APIs and Services &gt; Credentials and select Create credentials &gt; API key.<LineBreak />
                                    5. Copy the key and paste it above. No billing account is required.
                                </TextBlock>
                                <HyperlinkButton Content="Open console.cloud.google.com" NavigateUri="https://console.cloud.google.com/apis/library/youtube.googleapis.com" Padding="0" />
                            </StackPanel>
                        </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <tk:SettingsExpander Header="Last.fm" Description="Detailed genres such as Tropical House, EDM or Metal.">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8EC;" /></tk:SettingsExpander.HeaderIcon>
                <controls:ApiKeyField x:Name="LastFmKey" />
                <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="How to get a free key" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    1. Open the Last.fm API account page and sign in (or create a free Last.fm account).<LineBreak />
                                    2. Enter an application name, for example "Music Player", and a short description. The callback URL can be left empty.<LineBreak />
                                    3. Select Submit, then copy the API key (not the shared secret) and paste it above.
                                </TextBlock>
                                <HyperlinkButton Content="Open last.fm/api/account/create" NavigateUri="https://www.last.fm/api/account/create" Padding="0" />
                            </StackPanel>
                        </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <tk:SettingsExpander Header="Fanart.tv" Description="High-quality artist photos, matched exactly by MusicBrainz artist ID.">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE91B;" /></tk:SettingsExpander.HeaderIcon>
                <controls:ApiKeyField x:Name="FanartKey" />
                <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="How to get a free key" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    1. Create a free account on fanart.tv and sign in.<LineBreak />
                                    2. Open the "Get an API key" page and request a personal API key.<LineBreak />
                                    3. Copy the key and paste it above.
                                </TextBlock>
                                <HyperlinkButton Content="Open fanart.tv/get-an-api-key" NavigateUri="https://fanart.tv/get-an-api-key/" Padding="0" />
                            </StackPanel>
                        </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <tk:SettingsExpander Header="Spotify" Description="Artist photos for artists that other sources don't cover, including smaller and independent artists.">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE93C;" /></tk:SettingsExpander.HeaderIcon>
                <controls:ApiKeyField x:Name="SpotifyKey" />
                <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="How to get a free client ID and secret" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    1. Open the Spotify Developer Dashboard and sign in with a free Spotify account.<LineBreak />
                                    2. Select Create app. Enter a name, for example "Music Player", and a short description.<LineBreak />
                                    3. For Redirect URI enter http://127.0.0.1:8888/callback (required by the form, not used by the app), tick Web API, accept the terms and select Save.<LineBreak />
                                    4. Open the app's Settings, copy the Client ID, select View client secret and copy it.<LineBreak />
                                    5. Paste both above. No Spotify Premium is needed.
                                </TextBlock>
                                <HyperlinkButton Content="Open developer.spotify.com/dashboard" NavigateUri="https://developer.spotify.com/dashboard" Padding="0" />
                            </StackPanel>
                        </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- ================= Debug (temporary; to be removed) ================= -->
            <TextBlock Text="Debug" Style="{StaticResource GroupHeader}" />
            <tk:SettingsCard Header="Greeting" Description="Banner: the greeting on a gradient card. Gradient: no card; an accent glow runs from the top of Home to the middle of Quick access and fades into the background.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE706;" /></tk:SettingsCard.HeaderIcon>
                <ComboBox SelectedIndex="{x:Bind Vm.GreetingStyleIndex, Mode=TwoWay}" MinWidth="180" AutomationProperties.Name="Greeting">
                    <x:String>Banner</x:String>
                    <x:String>Gradient</x:String>
                    <x:String>None</x:String>
                </ComboBox>
            </tk:SettingsCard>
            <tk:SettingsCard Header="Match whole albums" Description="Songs of one album (same folder and album label) are matched to the same release, so the album stays together. Off: each song is matched on its own, as before.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE93C;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind Vm.MatchWholeAlbums, Mode=TwoWay}" AutomationProperties.Name="Match whole albums" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Show all Home rows" Description="Shows rows that wait for listening history. Long Time No Play appears by itself after a week of use and 15 different songs played.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE80F;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind Vm.ShowAllHomeRows, Mode=TwoWay}" AutomationProperties.Name="Show all Home rows" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Create test playlists" Description="Creates 10 playlists named &quot;Test playlist 1&quot; to &quot;Test playlist 10&quot;, each with 20 random songs from your library.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEBE8;" /></tk:SettingsCard.HeaderIcon>
                <Button Content="Create" Click="OnCreateTestPlaylists" />
            </tk:SettingsCard>

            <!-- ================= About ================= -->
            <TextBlock Text="About" Style="{StaticResource GroupHeader}" />
            <tk:SettingsExpander Header="{x:Bind Vm.AppName}" Description="{x:Bind Vm.AboutDescription, Mode=OneWay}">
                <tk:SettingsExpander.HeaderIcon>
                    <BitmapIcon UriSource="ms-appx:///Assets/AppIcon.png" ShowAsMonochrome="False" />
                </tk:SettingsExpander.HeaderIcon>
                <Button Content="Open data folder" Click="OnOpenData" />
                <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="Supported formats" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8A5;" /></tk:SettingsCard.HeaderIcon>
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="MP3, FLAC, ALAC, AAC, Opus, Vorbis, WAV, AIFF, WMA, APE, WavPack, Musepack, TTA, TAK, DSD, AC-3, E-AC-3, DTS, TrueHD, MKA, WebM, AMR, CAF and other formats supported by FFmpeg." />
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="Keyboard shortcuts" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE765;" /></tk:SettingsCard.HeaderIcon>
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Space or Ctrl+P: Play/Pause · Ctrl+Right: Next · Ctrl+Left: Previous · Ctrl+Up/Down: Volume · Ctrl+S: Shuffle · Ctrl+R: Repeat · Ctrl+F: Search · Ctrl+M: Mini player · F11: Now Playing · Esc: Close Now Playing or end a selection" />
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="License" Description="Free and open-source software under the GNU General Public License, version 3 (GPL-3.0). The components in Credits keep their own licenses.">
                            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8D7;" /></tk:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Third-party notices" Click="OnOpenNotices" />
                                <HyperlinkButton x:Name="LicenseLink" Content="Read the license" />
                            </StackPanel>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="Source code" Description="The project on GitHub.">
                            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE943;" /></tk:SettingsCard.HeaderIcon>
                            <HyperlinkButton x:Name="SourceLink" Content="Open on GitHub" />
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="Report a problem" Description="Describe what happened and attach the log. The log lists what the app did, including the paths of song files, so look through it before you share it.">
                            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEBE8;" /></tk:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Open log" Click="OnOpenLog" />
                                <HyperlinkButton x:Name="IssuesLink" Content="Report on GitHub" />
                            </StackPanel>
                        </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>
            <tk:SettingsExpander Header="Credits" Description="The open-source components this app is built with, and the online services it gets song details, covers, photos and lyrics from.">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE716;" /></tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="Built with" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <ItemsControl x:Name="ComponentCredits" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="helpers:Credit">
                                    <Grid ColumnSpacing="16" Padding="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>
                                        <HyperlinkButton Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top" NavigateUri="{x:Bind Link}"
                                                         ToolTipService.ToolTip="{x:Bind Url}" AutomationProperties.Name="{x:Bind Name}">
                                            <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                        </HyperlinkButton>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Use}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,1,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind License}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,1,0,0"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Online services" Description="Thanks to the people who run and fill these services. Each one is only asked when a song needs it." ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <ItemsControl x:Name="ServiceCredits" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="helpers:Credit">
                                    <Grid ColumnSpacing="16" Padding="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>
                                        <HyperlinkButton Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top" NavigateUri="{x:Bind Link}"
                                                         ToolTipService.ToolTip="{x:Bind Url}" AutomationProperties.Name="{x:Bind Name}">
                                            <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                        </HyperlinkButton>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Use}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,1,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind License}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,1,0,0"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
