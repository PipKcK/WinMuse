<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinMuse.Views.AlbumDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinMuse.Controls">

    <Grid RowDefinitions="Auto,*">
        <!-- Header with a soft, color-washed version of the cover behind it -->
        <Grid x:Name="Header" Height="300">
            <controls:ArtImage x:Name="Backdrop" DecodeSize="12" Opacity="0.55" Glyph="" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="Transparent" />
                        <GradientStop x:Name="FadeStop" Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Fill="{ThemeResource LayerFillColorDefaultBrush}" Opacity="0.6" />

            <Grid Padding="36,32,36,24" ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:ArtImage x:Name="Cover" Width="220" Height="220" CornerRadius="14" DecodeSize="300" />
                <StackPanel x:Name="Info" Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                    <TextBlock Text="ALBUM" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CharacterSpacing="120" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource TitleLargeTextBlockStyle}" FontWeight="Bold" TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <HyperlinkButton x:Name="ArtistLink" Padding="0" Click="OnArtist" FontWeight="SemiBold" />
                        <TextBlock x:Name="MetaText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,0">
                        <Button Style="{StaticResource PillButtonStyle}" Click="OnPlay">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock Text="Play" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostPillButtonStyle}" Click="OnShuffle">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B1;" FontSize="14" /><TextBlock Text="Shuffle" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8FD;" Click="OnQueue" ToolTipService.ToolTip="Add to queue" AutomationProperties.Name="Add to queue" />
                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE70F;" Click="OnEdit" ToolTipService.ToolTip="Edit album" AutomationProperties.Name="Edit album" />
                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE712;" Click="OnMore" ToolTipService.ToolTip="More" AutomationProperties.Name="More" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <controls:TrackList x:Name="Tracks" Grid.Row="1" />
    </Grid>
</Page>
