<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinMuse.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinMuse.Controls"
    xmlns:models="using:WinMuse.Models"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <ItemsPanelTemplate x:Key="ShelfPanel">
            <!-- Spacing lives on the panel (inside the row's content), so the whole row passes the wheel to the page;
                 the top room lets cards grow on hover without being clipped. -->
            <ItemsStackPanel Orientation="Horizontal" Margin="6,8,6,14" />
        </ItemsPanelTemplate>
        <!-- Each shelf sits in a ShelfRow: the wheel scrolls the page; arrows appear while pointing at the row.
             Shelf cards draw their own hover; the item containers stay invisible. -->
        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
        <Style x:Key="ShelfItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="0" />
            <!-- 10 px plus the idle shrink of each card (see ShelfEffects.RestScale) reads as a 16 px gap. -->
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style x:Key="ShelfStyle" TargetType="ListView">
            <Setter Property="ItemsPanel" Value="{StaticResource ShelfPanel}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ShelfItemStyle}" />
            <!-- Cards cut off at either end fade out (Controls/ShelfEffects.cs); delete this line to turn it off. -->
            <Setter Property="controls:ShelfEffects.EdgeFade" Value="True" />
            <Setter Property="SelectionMode" Value="None" />
            <Setter Property="IsItemClickEnabled" Value="True" />
            <!-- Touchpad swipes and touch scroll a row natively; ShelfRow handles the mouse wheel itself. -->
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Enabled" />
            <!-- No scrollbar: rows move with their arrows (or Shift + wheel / touchpad), and a scrollbar would catch the wheel. -->
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
            <!-- The viewport reaches 6 px past the row on each side, so cards can zoom on hover without being cut. -->
            <Setter Property="Margin" Value="-6,0,-6,0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="Scroller">
        <Grid x:Name="PageRoot">
        <!-- Greeting "Gradient" style: an accent glow from the top of the page that is still clearly there halfway
             down the Quick access tiles and fades out just below them (its height is set in code). A vertical wash
             plus two soft pools at the top corners. -->
        <Grid x:Name="GreetingGlow" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop x:Name="GlowWashTop" Offset="0" Color="#806D5DFC" />
                        <GradientStop x:Name="GlowWashMid" Offset="0.5" Color="#306D5DFC" />
                        <GradientStop x:Name="GlowWashEnd" Offset="1" Color="#006D5DFC" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.12,0" GradientOrigin="0.12,0" RadiusX="0.6" RadiusY="0.72">
                        <GradientStop x:Name="GlowLeft" Offset="0" Color="#B06D5DFC" />
                        <GradientStop x:Name="GlowLeftEnd" Offset="1" Color="#006D5DFC" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.88,0" GradientOrigin="0.88,0" RadiusX="0.55" RadiusY="0.66">
                        <GradientStop x:Name="GlowRight" Offset="0" Color="#A0FF6A88" />
                        <GradientStop x:Name="GlowRightEnd" Offset="1" Color="#00FF6A88" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <StackPanel x:Name="ContentStack" Padding="36,28,36,36" Spacing="32">

            <!-- Hero -->
            <Grid x:Name="Hero" CornerRadius="16" Padding="32,30">
                <Grid.Background>
                    <LinearGradientBrush x:Name="HeroBrush" StartPoint="0,0" EndPoint="1,1" Opacity="0.9">
                        <GradientStop x:Name="HeroStop1" Offset="0" Color="#FF6D5DFC" />
                        <GradientStop x:Name="HeroStop2" Offset="0.55" Color="#FFB14BE6" />
                        <GradientStop x:Name="HeroStop3" Offset="1" Color="#FFFF6A88" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <!-- Time-of-day icon: sun by day, moon in the evening; turns slowly. -->
                        <Grid Width="52" Height="52" CornerRadius="26" Background="#26FFFFFF" VerticalAlignment="Center">
                            <FontIcon x:Name="GreetingIcon" Glyph="&#xE706;" FontSize="28" Foreground="White" />
                        </Grid>
                        <TextBlock x:Name="Greeting" Style="{StaticResource TitleLargeTextBlockStyle}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="Stats" Style="{StaticResource BodyTextBlockStyle}" Foreground="#E6FFFFFF" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
                        <Button x:Name="ShuffleAllButton" Click="OnShuffleAll" Height="36" CornerRadius="18" Padding="18,0" Background="White" Foreground="#FF1A1A1A" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B1;" FontSize="15" />
                                <TextBlock Text="Shuffle All" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ResumeButton" Click="OnResume" Height="36" CornerRadius="18" Padding="16,0" Background="#33FFFFFF" Foreground="White" BorderThickness="0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock x:Name="ResumeText" Text="Resume" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <!-- Appearance: theme, card style and greeting, right from Home. -->
                <!-- Drawn by hand (bare template): a circle in the current card style (same brushes as Home's cards), the icon black or
                     white to suit the circle and what shows through it (UpdateAppearanceButton). -->
                <Button x:Name="AppearanceButton" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                        Width="40" Height="40" Padding="0" BorderThickness="0" Canvas.ZIndex="1"
                        ToolTipService.ToolTip="Appearance" AutomationProperties.Name="Appearance">
                    <Button.Template>
                        <ControlTemplate TargetType="Button"><ContentPresenter Background="Transparent" /></ControlTemplate>
                    </Button.Template>
                    <Grid Width="40" Height="40">
                        <Border x:Name="AppearanceDisc" Margin="2" CornerRadius="18" Background="{StaticResource ShelfCardBrush}"
                                BorderBrush="{StaticResource ShelfCardStrokeBrush}" BorderThickness="1">
                            <FontIcon x:Name="AppearanceIcon" Glyph="&#xE790;" FontSize="18" />
                        </Border>
                    </Grid>
                    <Button.Flyout>
                        <Flyout x:Name="AppearanceFlyout" Placement="BottomEdgeAlignedRight">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                    <Setter Property="MaxWidth" Value="560" />
                                    <Setter Property="Padding" Value="18,16" />
                                    <Setter Property="CornerRadius" Value="14" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <controls:AppearancePanel />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <!-- Stacked album art fan -->
                <Grid x:Name="ArtFan" Grid.Column="1" Width="230" Height="130" Margin="24,-8,40,-8" VerticalAlignment="Center" />
            </Grid>

            <!-- Welcome / empty library -->
            <Grid x:Name="Welcome" Visibility="Collapsed" CornerRadius="16" Padding="40" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14" HorizontalAlignment="Center" MaxWidth="560">
                    <FontIcon Glyph="&#xE8B7;" FontSize="44" Foreground="{StaticResource AccentGradientBrush}" />
                    <TextBlock x:Name="WelcomeTitle" Text="Set Up Your Library" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               x:Name="WelcomeText" Text="Add the folders that contain your music. Files remain on this PC. Supported formats include MP3, FLAC, ALAC, AAC, Opus, Vorbis, WAV, AIFF, APE, WavPack and DSD." />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Style="{StaticResource PillButtonStyle}" Click="OnUseMusicFolder">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEC4F;" FontSize="14" /><TextBlock x:Name="MusicFolderButtonText" Text="Add Music Folder" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostPillButtonStyle}" Click="OnAddFolder">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="Add Folder…" /></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Quick picks -->
            <StackPanel x:Name="QuickSection" Visibility="Collapsed">
                <TextBlock Text="Quick Access" Style="{StaticResource SectionTitleStyle}" />
                <!-- A plain ItemsControl (no virtualization or inner ScrollViewer): up to 10 tiles nested in the page scroller.
                     A virtualizing GridView here made UI Automation tree walks hang intermittently.
                     QuickGrid fits 2-5 columns to the width and shows at most 2 rows. -->
                <ItemsControl x:Name="QuickPicks" ItemTemplate="{StaticResource QuickEntryTemplate}" Margin="0,4,0,0" IsTabStop="False"
                              Tapped="OnQuickPickTapped" RightTapped="OnQuickPickRightTapped">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:QuickGrid MinItemWidth="250" MinColumns="2" MaxColumns="5" MaxItems="10" ItemHeight="64" Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- Automatic playlists (kept up to date by Music, not listed on the Playlists page): the title opens the playlist,
                 a card opens it and plays from that song, exactly like a playlist row below. -->
            <StackPanel x:Name="RecentAddedSection">
                <!-- Section heading: the title (opens the playlist) and a one-line subtitle. -->
                <StackPanel Margin="0,0,0,14" Spacing="0">
                    <Button Style="{StaticResource TextLinkButtonStyle}" controls:Effects.HoverUnderline="True" Tag="-1" Click="OnOpenSystemPlaylist"
                            HorizontalAlignment="Left" Padding="0,0,2,1" ToolTipService.ToolTip="Open playlist (updates automatically)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Fresh in Your Library" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                            <FontIcon Glyph="&#xE76C;" FontSize="13" VerticalAlignment="Center" Margin="0,3,0,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Your latest additions to the library." Style="{StaticResource CaptionTextBlockStyle}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <controls:ShelfRow><ListView x:Name="RecentAdded" Tag="-1" Style="{StaticResource ShelfStyle}" ItemTemplate="{StaticResource ShelfSongCardTemplate}" ItemClick="OnSystemSongClick" /></controls:ShelfRow>
            </StackPanel>

            <!-- Continue Listening: where each playlist, album, artist or song was left off (Services/ContinueListeningService). -->
            <StackPanel x:Name="ContinueSection" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,14" Spacing="0">
                    <TextBlock Text="Continue Listening" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" Margin="0,0,0,1" />
                    <TextBlock Text="Pick up right where you left off." Style="{StaticResource CaptionTextBlockStyle}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <controls:ShelfRow><ListView x:Name="ContinueRow" Style="{StaticResource ShelfStyle}" ItemTemplate="{StaticResource ShelfContinueCardTemplate}"
                                             ItemClick="OnContinueClick" RightTapped="OnContinueRightTapped" /></controls:ShelfRow>
            </StackPanel>

            <StackPanel x:Name="MostPlayedSection">
                <!-- Section heading: the title (opens the playlist) and a one-line subtitle. -->
                <StackPanel Margin="0,0,0,14" Spacing="0">
                    <Button Style="{StaticResource TextLinkButtonStyle}" controls:Effects.HoverUnderline="True" Tag="-3" Click="OnOpenSystemPlaylist"
                            HorizontalAlignment="Left" Padding="0,0,2,1" ToolTipService.ToolTip="Open playlist (updates automatically)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="On Repeat" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                            <FontIcon Glyph="&#xE76C;" FontSize="13" VerticalAlignment="Center" Margin="0,3,0,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Tracks you can’t stop playing." Style="{StaticResource CaptionTextBlockStyle}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <controls:ShelfRow><ListView x:Name="MostPlayed" Tag="-3" Style="{StaticResource ShelfStyle}" ItemTemplate="{StaticResource ShelfSongCardTemplate}" ItemClick="OnSystemSongClick" /></controls:ShelfRow>
            </StackPanel>

            <StackPanel x:Name="RediscoverSection">
                <!-- Section heading: the title (opens the playlist) and a one-line subtitle. -->
                <StackPanel Margin="0,0,0,14" Spacing="0">
                    <Button Style="{StaticResource TextLinkButtonStyle}" controls:Effects.HoverUnderline="True" Tag="-4" Click="OnOpenSystemPlaylist"
                            HorizontalAlignment="Left" Padding="0,0,2,1" ToolTipService.ToolTip="Open playlist (updates automatically)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Long Time No Play" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                            <FontIcon Glyph="&#xE76C;" FontSize="13" VerticalAlignment="Center" Margin="0,3,0,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Rediscover tracks you haven’t played in a while." Style="{StaticResource CaptionTextBlockStyle}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <controls:ShelfRow><ListView x:Name="Rediscover" Tag="-4" Style="{StaticResource ShelfStyle}" ItemTemplate="{StaticResource ShelfSongCardTemplate}" ItemClick="OnSystemSongClick" /></controls:ShelfRow>
            </StackPanel>

            <!-- Playlists: a top-level heading (one level above the section titles), then one row of songs per playlist. -->
            <StackPanel x:Name="PlaylistsSection" Spacing="24" Margin="0,16,0,0">
                <!-- Heading: lines lead into a badge with the music icon, "Playlists" (opens the Playlists page) and the sort box. -->
                <Grid ColumnSpacing="16" Margin="0,8,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="52" Height="52" CornerRadius="16" Background="{StaticResource AccentGradientBrush}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8D6;" FontSize="24" Foreground="White" />
                    </Grid>
                    <Button Grid.Column="1" Click="OnSeePlaylists" Style="{StaticResource TextLinkButtonStyle}" controls:Effects.HoverUnderline="True" Padding="0,0,4,2"
                            VerticalAlignment="Center" ToolTipService.ToolTip="Open Playlists" AutomationProperties.Name="Playlists">
                        <StackPanel Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Playlists" Style="{StaticResource TitleLargeTextBlockStyle}" FontWeight="Bold" />
                                <FontIcon Glyph="&#xE76C;" FontSize="18" VerticalAlignment="Center" Margin="0,6,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="PlaylistCountText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                    <!-- A fading accent line runs from the title to the sort box. -->
                    <Rectangle Grid.Column="2" Height="2" RadiusX="1" RadiusY="1" VerticalAlignment="Center" Opacity="0.6">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop x:Name="PlaylistLineStop" Offset="0" Color="#FF60CDFF" />
                                <GradientStop Offset="1" Color="#00FFFFFF" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <ComboBox x:Name="PlaylistSortBox" Grid.Column="3" VerticalAlignment="Center" MinWidth="170" SelectionChanged="OnPlaylistSortChanged"
                              AutomationProperties.Name="Sort playlists" ToolTipService.ToolTip="Sort playlists">
                        <x:String>Alphabetical</x:String>
                        <x:String>Recent Activity</x:String>
                        <x:String>Date Created</x:String>
                        <x:String>Custom Order</x:String>
                    </ComboBox>
                </Grid>

                <!-- One section per playlist. A plain ItemsControl (no virtualization) inside the page scroller. -->
                <ItemsControl x:Name="HomePlaylists" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="32" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Playlist">
                            <!-- The title opens the playlist (underlined on hover). -->
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Button HorizontalAlignment="Left" Click="OnOpenPlaylist" Style="{StaticResource TextLinkButtonStyle}" controls:Effects.HoverUnderline="True"
                                            Padding="0,2,2,4" Margin="0,-2,96,0" ToolTipService.ToolTip="Open playlist">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <FontIcon Glyph="&#xE76C;" FontSize="13" VerticalAlignment="Center" Margin="0,3,0,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                        <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Content="&#xE74A;" FontSize="12" Click="OnMovePlaylistUp"
                                                Visibility="{x:Bind CanMove, Mode=OneWay}" ToolTipService.ToolTip="Move up" AutomationProperties.Name="Move up" />
                                        <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Content="&#xE74B;" FontSize="12" Click="OnMovePlaylistDown"
                                                Visibility="{x:Bind CanMove, Mode=OneWay}" ToolTipService.ToolTip="Move down" AutomationProperties.Name="Move down" />
                                    </StackPanel>
                                </Grid>
                                <controls:ShelfRow><ListView Style="{StaticResource ShelfStyle}" ItemsSource="{x:Bind Tracks}" ItemTemplate="{StaticResource ShelfSongCardTemplate}" ItemClick="OnPlaylistSongClick" /></controls:ShelfRow>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
