<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinMuse.Views.ArtistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <Grid RowDefinitions="Auto,*">
        <Grid x:Name="Header" Padding="36,28,36,12">
            <StackPanel Spacing="2">
                <TextBlock Text="Artists" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="CountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox x:Name="FilterBox" PlaceholderText="Search artists…" Width="220" VerticalAlignment="Center" TextChanged="OnFilter" />
                <ComboBox x:Name="SortBox" SelectionChanged="OnSortChanged" MinWidth="170" VerticalAlignment="Center"
                          AutomationProperties.Name="Sort artists" ToolTipService.ToolTip="Sort artists">
                    <x:String>A–Z</x:String>
                    <x:String>Recently changed</x:String>
                    <x:String>Most songs</x:String>
                </ComboBox>
                <Button Style="{StaticResource GhostPillButtonStyle}" Click="OnNewArtist" ToolTipService.ToolTip="Create an artist and credit songs to them" AutomationProperties.Name="New Artist">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="New Artist" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <GridView x:Name="Grid" Grid.Row="1" Padding="32,4,24,24"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick" RightTapped="OnRightTapped"
                  ItemTemplate="{StaticResource ArtistCardTemplate}"
                  ItemContainerStyle="{StaticResource CardGridViewItemStyle}" />
    </Grid>
</Page>
